cat <<EOF > .gitignore
# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ / Eclipse / VSCode
.idea/
*.iml
*.ipr
*.iws
*.classpath
*.project
*.settings/
.vscode/

# OS crap
.DS_Store
Thumbs.db

# Logs
*.log

# Temp files
*.tmp
*.swp

# Env
.env
EOF
